{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "diff-checker",
  "title": "Diff Checker",
  "description": "Compare content of two texts",
  "icon": "icon.png",
  "author": "almatkai",
  "contributors": [
    "hayk_hayrapetian"
  ],
  "categories": [
    "Data",
    "Developer Tools"
  ],
  "license": "MIT",
  "keywords": [
    "diff",
    "compare",
    "json",
    "text",
    "difference"
  ],
  "commands": [
    {
      "name": "check-diff",
      "title": "Check Diff",
      "description": "Compare two text snippets line by line",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "compare-json",
      "title": "Compare JSON",
      "description": "Paste two JSON snippets to see the differences",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "diff": "8.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.diff-checker",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/diff-checker",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/diff-checker",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
